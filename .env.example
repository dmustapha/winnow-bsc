# Operator EOA private key (signs registry writes, owns Altana wallets) — obtain from: existing pipeline credentials
EVM_PRIVATE_KEY=0xplaceholder
# Claude API key for agent reasoning — obtain from: console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-placeholder
# Write-side chain: testnet (tonight) | mainnet (after morning funding)
WINNOW_CHAIN=testnet
# SQLite path (Fly volume in prod)
DB_PATH=./data/winnow.db
# Optional second attestor key so reference agents (owned by operator) can receive attestations — obtain from: cast wallet new
ATTESTOR2_PRIVATE_KEY=
# Live Aave v3 BSC account to monitor (health agent) — obtain from: bscscan Aave Pool events at build
WATCH_ADDR=
# PCS v3 pool for rebalancer — obtain from: factory getPool(WBNB,USDT,500) at build
PCS_POOL=
# Optional RPC overrides
BSC_RPC=
BSC_TESTNET_RPC=
